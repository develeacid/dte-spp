APP_NAME="DTE-SPP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://srv1476074.hstgr.cloud

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dte_spp
DB_USERNAME=sail
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# DOCKER / SAIL — REQUERIDOS EN PRODUCCIÓN
# ============================================================

# GID del grupo www-data del host (normalmente 1000 en Ubuntu)
WWWGROUP=1000

# UID del usuario que corre Docker en el host (normalmente 1000)
WWWUSER=1000

# Puerto externo donde escucha este proyecto (Nginx redirige aquí)
APP_PORT=8080

# Comando PHP que arranca el servidor dentro del contenedor
SUPERVISOR_PHP_COMMAND="/usr/bin/php -d variables_order=EGPCS /var/www/html/artisan serve --host=0.0.0.0 --port=80"
SUPERVISOR_PHP_USER=sail

# ============================================================
# AUTENTICACIÓN
# ============================================================

# 2FA — poner true solo si se habilita en producción
FORTIFY_TWO_FACTOR=false

# ============================================================
# EMBEDDINGS (opcional — dejar vacío si no se usa)
# ============================================================

EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536
EMBEDDING_RATE_LIMIT=60
EMBEDDING_TIMEOUT=30
EMBEDDING_QUEUE=embeddings
EMBEDDING_JOB_TRIES=3
EMBEDDING_JOB_TIMEOUT=60
EMBEDDING_MAX_TOKENS=8000
EMBEDDING_OBSERVERS_ENABLED=false
EMBEDDING_SIMILARITY_THRESHOLD=0.7
EMBEDDING_MAX_RESULTS=5
EMBEDDING_HNSW_M=16
EMBEDDING_HNSW_EF_CONSTRUCTION=64
EMBEDDING_HNSW_EF_SEARCH=40
